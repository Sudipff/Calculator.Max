# Gemini API Key for server-side AI chatbot support assistant
GEMINI_API_KEY=

# Supabase configuration for Authentication and Database persistence
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-side cryptographic secrets (generate 32-byte random hex/strings in production)
AUTH_SESSION_SECRET=
DATA_ENCRYPTION_KEY=

# Optional comma-separated list of admin email addresses for RBAC audit access
ADMIN_EMAILS=
